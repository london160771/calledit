# Optional for /judge; required for live Twitch: Client ID from your Twitch Developer Console application.
TWITCH_CLIENT_ID=
# Required for live Twitch: Client secret from that same confidential Twitch application. Keep it private.
TWITCH_CLIENT_SECRET=
# Register this exact OAuth redirect URL in your Twitch application (default shown).
TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback
# Optional: Existing user access token with user:read:chat user:write:chat user:bot; otherwise sign in locally.
TWITCH_ACCESS_TOKEN=
# Optional: Matching refresh token for that access token; otherwise sign in locally.
TWITCH_REFRESH_TOKEN=
# Live sync reply window in milliseconds (default 45000); engine and Seed-7 defaults are unchanged.
LIVE_SYNC_WINDOW_MS=45000
# Live delay sample cap and round finalization delay in milliseconds (default 45000).
LIVE_MAX_DELAY_MS=45000

# Optional public HTTPS origin; defaults to RENDER_EXTERNAL_URL on Render, otherwise localhost:3000.
APP_ORIGIN=
# Required for hosted live controls: private owner password (HTTP Basic username is owner); never put it in OBS URLs.
DASHBOARD_PASSWORD=
# Optional listen port; Render supplies PORT automatically, local default is 3000.
PORT=3000
