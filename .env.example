# Required: Client ID from your Twitch Developer Console application.
TWITCH_CLIENT_ID=
# Required: Client secret from that same confidential Twitch application. Keep it private.
TWITCH_CLIENT_SECRET=
# Register this exact OAuth redirect URL in your Twitch application (default shown).
TWITCH_REDIRECT_URI=http://localhost:3000/auth/callback
# Optional: Existing user access token with user:read:chat user:write:chat user:bot; otherwise sign in locally.
TWITCH_ACCESS_TOKEN=
# Optional: Matching refresh token for that access token; otherwise sign in locally.
TWITCH_REFRESH_TOKEN=
