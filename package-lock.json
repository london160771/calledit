      "link": true
    },
    "node_modules/@calledit/web": {
      "resolved": "web",
      "link": true
    },
    "server": {
      "name": "@calledit/server",
      "version": "1.0.0"
    },
    "web": {
      "name": "@calledit/web",
      "version": "1.0.0"
